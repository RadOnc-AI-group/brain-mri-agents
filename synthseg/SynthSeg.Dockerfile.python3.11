# FROM tensorflow/tensorflow:2.2.0-gpu
FROM python:3.11.5

# Optional: set a working directory
WORKDIR /SynthSeg

# Copy all files into the container
COPY . /SynthSeg

# Upgrade pip and install requirements
RUN pip install --upgrade pip && \
    pip install -r requirements_python3.11.txt

# Set default command (can still be overridden at runtime)
# ENTRYPOINT ["python", "scripts/commands/SynthSeg_predict.py"]

ENTRYPOINT ["python", "scripts/commands/SynthSeg_predict.py", "--robust"]
CMD []